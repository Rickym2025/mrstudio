{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/public/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/orbit-template.html",
      "destination": "/public/orbit-template.html"
    },
    {
      "source": "/orbit-template",
      "destination": "/public/orbit-template.html"
    },
    {
      "source": "/cookie-banner.js",
      "destination": "/public/cookie-banner.js"
    },
    {
      "source": "/chatbot.js",
      "destination": "/public/chatbot.js"
    }
  ]
}
